local function createRow(parentPage, name, isToggle, callback)
    local rowFrame = Instance.new("Frame", parentPage)
    rowFrame.Size = UDim2.new(1, 0, 0, 44)
    rowFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Instance.new("UICorner", rowFrame).CornerRadius = UDim.new(0, 6)
    
    local label = Instance.new("TextLabel", rowFrame)
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Text = name
    label.Font = Enum.Font.GothamSemibold
    label.TextColor3 = Color3.fromRGB(225, 225, 225)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    
    local actionBtn = Instance.new("TextButton", rowFrame)
    actionBtn.Size = UDim2.new(1, 0, 1, 0)
    actionBtn.BackgroundTransparency = 1
    actionBtn.Text = ""
    
    local indicator = Instance.new("TextLabel", rowFrame)
    indicator.Size = UDim2.new(0, 100, 1, 0)
    indicator.Position = UDim2.new(1, -115, 0, 0)
    indicator.Font = Enum.Font.GothamBold
    indicator.TextSize = 12
    indicator.TextXAlignment = Enum.TextXAlignment.Right
    indicator.BackgroundTransparency = 1
    
    if isToggle then
        indicator.Text = "OFF"
        indicator.TextColor3 = Color3.fromRGB(240, 90, 90)
        local active = false
        actionBtn.MouseButton1Click:Connect(function()
            active = not active
            indicator.Text = active and "ON" or "OFF"
            indicator.TextColor3 = active and Color3.fromRGB(90, 240, 90) or Color3.fromRGB(240, 90, 90)
            rowFrame.BackgroundColor3 = active and Color3.fromRGB(36, 36, 36) or Color3.fromRGB(30, 30, 30)
            callback(active)
        end)
    else
        indicator.Text = "CLIQUE >"
        indicator.TextColor3 = Color3.fromRGB(160, 160, 160)
        actionBtn.MouseButton1Click:Connect(function()
            callback()
        end)
    end
end

local function createTextBoxRow(parentPage, name, min, max, defaultVal, placeholder, callback)
    local rowFrame = Instance.new("Frame", parentPage)
    rowFrame.Size = UDim2.new(1, 0, 0, 44)
    rowFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Instance.new("UICorner", rowFrame).CornerRadius = UDim.new(0, 6)
    
    local label = Instance.new("TextLabel", rowFrame)
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Text = name
    label.Font = Enum.Font.GothamSemibold
    label.TextColor3 = Color3.fromRGB(225, 225, 225)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    
    local box = Instance.new("TextBox", rowFrame)
    box.Size = UDim2.new(0, 90, 0, 26)
    box.Position = UDim2.new(1, -105, 0.5, -13)
    box.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 12
    box.BorderSizePixel = 0
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
    
    box:GetPropertyChangedSignal("Text"):Connect(function()
        local num = tonumber(box.Text)
        if num then
            if num > max then num = max elseif num < min then num = min end
            callback(num)
        end
    end)
end

