-- ==================== LOOP PRINCIPAL (HEARTBEAT) ====================

RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local humanoid = char:FindFirstChild("Humanoid")

    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        if humanoid.Sit then humanoid.Sit = false end
        humanoid.WalkSpeed = states.SpeedValue
        humanoid.UseJumpPower = true
        humanoid.JumpPower = states.JumpValue
    end
    
    if root.RotVelocity.Magnitude > 50 and not states.Spin then root.RotVelocity = Vector3.new(0, 0, 0) end

    -- NOVO FLY MOBILE 100% CORRIGIDO (SEM INVERSÃO)
    if states.Fly then
        root.Velocity = Vector3.new(0, 0, 0)
        local camera = workspace.CurrentCamera
        if camera and humanoid then
            if humanoid.MoveDirection.Magnitude > 0 then
                local look = camera.CFrame.LookVector
                local horizontalDir = humanoid.MoveDirection
                
                -- Descobre se você está indo para frente ou para trás para alinhar a subida/descida vertical
                local forwardDot = horizontalDir:Dot(Vector3.new(look.X, 0, look.Z).Unit)
                local yComponent = look.Y * forwardDot
                
                -- Cria o vetor de voo final combinando o analógico e o ângulo da câmera
                local flyVelocity = Vector3.new(horizontalDir.X, yComponent, horizontalDir.Z)
                if flyVelocity.Magnitude > 0 then flyVelocity = flyVelocity.Unit end
                
                -- Move o personagem de forma absoluta no espaço do mundo (Evita bugs de rotação)
                root.CFrame = CFrame.lookAt(root.Position + (flyVelocity * states.SpeedValue * dt), root.Position + (flyVelocity * states.SpeedValue * dt) + look)
            else
                -- Trava flutuando no ar parado virado para onde você olha
                root.CFrame = CFrame.lookAt(root.Position, root.Position + camera.CFrame.LookVector)
            end
        end
    end

    if states.Noclip then
        for _, part in ipairs(char:GetChildren()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end

    if states.Spin then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(states.SpinForce * dt * 5), 0) end

    if states.Caseoh then
        local target = workspace:FindFirstChild("becomeCase")
        if target then root.CFrame = target:IsA("Model") and target:GetPivot() or target.CFrame end
    end

    if states.Dup and (tick() - lastDuplicateTime) > 1 then
        local target = workspace:FindFirstChild("becomeCase")
        if target then
            local clone = target:Clone()
            clone.Parent = workspace
            if clone:IsA("BasePart") then clone.Position = target.Position + Vector3.new(0, 5, 0)
            elseif clone:IsA("Model") then clone:PivotTo(target:GetPivot() * CFrame.new(0, 5, 0)) end
            lastDuplicateTime = tick()
        end
    end

    if states.Farm1 then
        local target = workspace:FindFirstChild("Escape") or workspace:FindFirstChild("escape") or workspace:FindFirstChild("ESCAPE") or workspace:FindFirstChild("escapa") or workspace:FindFirstChild("Escapa")
        if target then root.CFrame = target:IsA("Model") and target:GetPivot() or target.CFrame end
    end

    if states.Farm2 or states.Farm3 then
        local restaurant = workspace:FindFirstChild("Restaurant")
        if restaurant then
            local structure = restaurant:FindFirstChild("Structure")
            if structure and structure:FindFirstChild("Part") then
                root.CFrame = structure.Part.CFrame * CFrame.new(0, 2, 0)
            end
        end
    end

    if states.CFrameSpeedActive and humanoid and humanoid.MoveDirection.Magnitude > 0 then
        local extraSpeed = cframeSpeedValue - 16
        if extraSpeed > 0 then root.CFrame = root.CFrame + (humanoid.MoveDirection * (extraSpeed * dt)) end
    end
end)
