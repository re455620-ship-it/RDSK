            while botGearAtivo do
               local char = player.Character
               if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                  local hum = char.Humanoid
                  local hrp = char.HumanoidRootPart
                  
                  local closest, minDist, furthest, maxDist = getPlayersByDistance()
                  
                  -- 1. ALGUÉM MUITO PERTO: Solta a Bomba (Gear 1) e foge!
                  if closest and minDist < 15 then
                      local bomb = equipGear(1)
                      if bomb then
                          bomb:Activate() -- Solta a bomba
                          task.wait(0.2)
                          
                          -- Calcula a direção oposta do inimigo para fugir
                          local dirFuga = (hrp.Position - closest.HumanoidRootPart.Position).Unit
                          local posFuga = hrp.Position + (dirFuga * 30)
                          hum:MoveTo(posFuga)
                          task.wait(1) -- Corre por 1 segundo para se afastar da explosão
                      end
                      
                  -- 2. INIMIGOS LONGE: Usa a arma de longa distância (Gear 2) ou a branca (Gear 3)
                  elseif furthest then
                      -- Movimentação Aleatória para desviar de tiros enquanto ataca
                      local posAleatoria = hrp.Position + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
                      hum:MoveTo(posAleatoria)
                      
                      -- Vira o corpo para atirar no cara mais longe
                      hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(furthest.HumanoidRootPart.Position.X, hrp.Position.Y, furthest.HumanoidRootPart.Position.Z))
                      
                      -- Checagem simples para simular a "Ponte": Verifica se tem chão no meio do caminho usando Raycast
                      local rayOrigin = hrp.Position
                      local rayDirection = (furthest.HumanoidRootPart.Position - hrp.Position).Unit * maxDist
                      local raycastParams = RaycastParams.new()
                      raycastParams.FilterDescendantsInstances = {char}
                      raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                      
                      local rayResult = workspace:Raycast(rayOrigin - Vector3.new(0, 5, 0), rayDirection, raycastParams)
                      
                      -- Se o Raycast bater em algo (ponte construída) e não for um buraco, tenta usar a Gear 3
                      if rayResult and rayResult.Instance then
                          local whiteGear = equipGear(3)
                          if whiteGear then
                              whiteGear:Activate()
                          end
                      else
                          -- Caso contrário (sem ponte/espaço aberto), usa a arma padrão de longe (Gear 2)
                          local gunGear = equipGear(2)
                          if gunGear then
                              gunGear:Activate()
                          end
                      end
                  end
               end
               task.wait(0.3) -- Loop de decisão do Bot
            end
         end)
      end
   end,
})
