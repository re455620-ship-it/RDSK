-- 1 Fling Sofá (Lógica adaptada do seu script)
Tab3:CreateButton({
   Name = "1 Fling Sofá (Void + Spin 1000)",
   Callback = function()
      local targetPlayer = getTargetPlayer(targetBh)
      if not targetPlayer then
          Rayfield:Notify({Title = "Erro", Content = "Jogador não encontrado!", Duration = 3})
          return
      end

      local character = player.Character or player.CharacterAdded:Wait()
      local humanoid = character:WaitForChild("Humanoid")
      local rootPart = character:WaitForChild("HumanoidRootPart")

      local originalPosition = rootPart.CFrame
      local sofaLocation = CFrame.new(-82.620, 19.371, -130.035)
      rootPart.CFrame = sofaLocation
      
      local timeWaited = 0
      while not humanoid.Sit and timeWaited < 3 do
          rootPart.CFrame = sofaLocation
          task.wait(0.1)
          timeWaited = timeWaited + 0.1
      end

      if humanoid.Sit then humanoid.Jump = true end
      task.wait(0.5)

      local grabbedTool = player.Backpack:FindFirstChildOfClass("Tool")
      if grabbedTool then humanoid:EquipTool(grabbedTool) end
      task.wait(0.5)

      local targetChar = targetPlayer.Character
      if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return end

      local spinVelocity = Instance.new("BodyAngularVelocity")
      spinVelocity.Name = "SpinVelocity1000"
      spinVelocity.Parent = rootPart
      spinVelocity.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
      spinVelocity.AngularVelocity = Vector3.new(0, 1000, 0)

      local lastPlatformStand = humanoid.PlatformStand
      humanoid.PlatformStand = true

      local flingTime = 10
      local startTime = tick()
      local conn

      conn = RunService.Heartbeat:Connect(function()
          if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
              rootPart.CFrame = targetChar.HumanoidRootPart.CFrame
          else
              conn:Disconnect()
          end
      end)

      repeat task.wait() until tick() - startTime >= flingTime

      conn:Disconnect()
      if spinVelocity then spinVelocity:Destroy() end
      humanoid.PlatformStand = lastPlatformStand
      
      rootPart.Velocity = Vector3.new(0,0,0)
      rootPart.RotVelocity = Vector3.new(0,0,0)

      local aboveVoidLocation = CFrame.new(0, -400, 0)
      rootPart.CFrame = aboveVoidLocation
      
      task.wait(0.5)
      humanoid:UnequipTools()
      task.wait(1.5)

      rootPart.CFrame = originalPosition
   end,
})

