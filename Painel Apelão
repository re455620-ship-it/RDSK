               if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                  local hum = char.Humanoid
                  local hrp = char.HumanoidRootPart
                  
                  local closest, minDist, furthest, maxDist = getPlayersByDistance()
                  
                  -- 1. MUITO PERTO: Gear 1 (Bomba) e corre
                  if closest and minDist < 15 then
                      local bomb = equipGear(1)
                      if bomb then
                          bomb:Activate()
                          task.wait(0.2)
                          
                          local dirFuga = (hrp.Position - closest.HumanoidRootPart.Position).Unit
                          local posFuga = hrp.Position + (dirFuga * 30)
                          hum:MoveTo(posFuga)
                          task.wait(1)
                      end
                      
                  -- 2. LONGE: Movimentação aleatória + Gear 2 ou Gear 3
                  elseif furthest then
                      local posAleatoria = hrp.Position + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
                      hum:MoveTo(posAleatoria)
                      
                      hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(furthest.HumanoidRootPart.Position.X, hrp.Position.Y, furthest.HumanoidRootPart.Position.Z))
                      
                      local rayOrigin = hrp.Position
                      local rayDirection = (furthest.HumanoidRootPart.Position - hrp.Position).Unit * maxDist
                      local raycastParams = RaycastParams.new()
                      raycastParams.FilterDescendantsInstances = {char}
                      raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                      
                      local rayResult = workspace:Raycast(rayOrigin - Vector3.new(0, 5, 0), rayDirection, raycastParams)
                      
                      if rayResult and rayResult.Instance then
                          local whiteGear = equipGear(3)
                          if whiteGear then whiteGear:Activate() end
                      else
                          local gunGear = equipGear(2)
                          if gunGear then gunGear:Activate() end
                      end
                  end
               end
               task.wait(0.3)
            end
         end)
      end
   end,
})

