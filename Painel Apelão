local function getPlayersByDistance()
    local closest = nil
    local furthest = nil
    local minDist = math.huge
    local maxDist = 0
    
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil, nil, nil, nil end
    local myPos = char.HumanoidRootPart.Position

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                local dist = (myPos - p.Character.HumanoidRootPart.Position).Magnitude
                
                if dist < minDist then
                    minDist = dist
                    closest = p.Character
                end
                
                if dist > maxDist then
                    maxDist = dist
                    furthest = p.Character
                end
            end
        end
    end

    return closest, minDist, furthest, maxDist
end

local function equipGear(slotNumber)
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChild("Humanoid")
    
    local backpackItems = player.Backpack:GetChildren()
    local equippedTool = char:FindFirstChildOfClass("Tool")
    
    if equippedTool then
        hum:UnequipTools()
        task.wait(0.1)
        backpackItems = player.Backpack:GetChildren()
    end
    
    local toolToEquip = backpackItems[slotNumber]
    if toolToEquip and hum then
        hum:EquipTool(toolToEquip)
        return toolToEquip
    end
    return nil
end

